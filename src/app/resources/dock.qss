/* The dock tray and its buttons. Colours are opaque on purpose: on non-
   default desktops DWM does not composite, so a translucent background
   renders invisible - do not switch these to rgba(). */
QWidget {
    background: #E2E8F0;
    border-radius: 18px;
}

QToolButton {
    background: #F8FAFC;
    border: 1px solid #CBD5E1;
    border-radius: 12px;
    min-width: 72px;
    min-height: 72px;
}

QToolButton:hover {
    background: #F1F5F9;
    border-color: #94A3B8;
}

QToolButton:pressed {
    background: #E2E8F0;
}
